<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>{{.Name}}</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- Usage strings for the capabilities the bundled GophicsPlatform host can
	     serve. iOS terminates an app that reaches one of these without a string,
	     and `gophics build` refuses earlier than that.

	     These are placeholders on purpose. The text is shown in the permission
	     prompt and read at App Review, so it has to say why *this* app needs the
	     thing — which no generator can know. Edit the ones you use and delete
	     the ones you do not: a prompt is more likely to be granted when it
	     explains itself, and an unused key invites a reviewer's question. -->
	<key>NSCameraUsageDescription</key>
	<string>TODO: say why {{.Name}} needs the camera.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>TODO: say why {{.Name}} needs the microphone.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>TODO: say why {{.Name}} needs your location.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>TODO: say why {{.Name}} saves pictures to your library.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>TODO: say why {{.Name}} uses Face ID.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
