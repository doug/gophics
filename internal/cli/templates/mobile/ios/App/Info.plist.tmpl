<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>{{html .Name}}</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- Usage strings for the permission-gated capabilities. iOS terminates an
	     app that reaches one of these without a string, and `gophics run`
	     refuses earlier than that.

	     Edit them in project.yml, not here: xcodegen regenerates this file from
	     project.yml on every `gophics run`, so a change made only here is gone
	     after the next build. The keys are mirrored here so the check sees the
	     same set before xcodegen has run for the first time.

	     These are placeholders on purpose. The text is shown in the permission
	     prompt and read at App Review, so it has to say why *this* app needs the
	     thing — which no generator can know. Edit the ones you use and delete
	     the ones you do not: a prompt is more likely to be granted when it
	     explains itself, and an unused key invites a reviewer's question.

	     Location, photos and Face ID are served by the bundled GophicsPlatform
	     host. Camera and microphone need a media host the app registers itself
	     (see shell/mobile/native/GophicsMedia.swift); until it does,
	     ctx.Camera() and ctx.Microphone() are nil. -->
	<key>NSCameraUsageDescription</key>
	<string>TODO: say why {{html .Name}} needs the camera.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>TODO: say why {{html .Name}} needs the microphone.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>TODO: say why {{html .Name}} needs your location.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>TODO: say why {{html .Name}} saves pictures to your library.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>TODO: say why {{html .Name}} uses Face ID.</string>
	<!-- Local networking (mirrors project.yml, which xcodegen regenerates this
	     file from): ATS allows private ranges and .local names, and iOS 14+
	     shows NSLocalNetworkUsageDescription before the first such connection.
	     Add <key>NSAllowsArbitraryLoads</key><true/> to the dict only if the
	     app must reach plain-http hosts that are not on the local network;
	     App Review asks for a justification, and https hosts never need it. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>TODO: say why {{html .Name}} connects to devices on your local network.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
